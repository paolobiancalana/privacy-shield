{
  "name": "@privacyshield/sdk",
  "version": "1.1.2",
  "description": "Privacy Shield PII Detection SDK for Node.js and browsers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "privacy",
    "pii",
    "ner",
    "gdpr",
    "tokenization",
    "italian"
  ],
  "author": "Privacy Shield",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
